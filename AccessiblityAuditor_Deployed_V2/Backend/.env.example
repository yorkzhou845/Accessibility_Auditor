# Local Ollama service and models
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=gemma3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Local CSV knowledge source and generated vector store
VECTOR_SOURCE_CSV=data/knowledge_base.csv
VECTOR_STORE_CSV=data/vector_store.csv
VECTOR_TOP_K=3

# Processing settings
ENGINE_TIMEOUT_SECONDS=3600
MAX_UPLOAD_MB=100
