# Local Ollama API. No API key is required for the default local endpoint.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_TIMEOUT_SECONDS=300

# Project directories. Relative paths are resolved from the current shell,
# so absolute paths are recommended when overriding the defaults.
INPUT_DIRECTORY=./input
OUTPUT_DIRECTORY=./output
KNOWLEDGE_DIRECTORY=./knowledge_base
VECTOR_CSV_PATH=./data/vector_store.csv

# Local retrieval settings.
USE_RETRIEVAL=true
REBUILD_VECTOR_STORE=false
RETRIEVAL_TOP_K=3
KNOWLEDGE_CHUNK_SIZE=1200

# Processing settings.
USE_LLM_FOR_SEMANTIC=false
MAX_PAGES=all
MAX_IMAGES_PER_PAGE=2
RENDER_SCALE=1.0
MAX_HEADING_CANDIDATES=80
FAILURE_REPORT_CHAR_LIMIT=1200
