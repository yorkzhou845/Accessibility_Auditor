@inject IConfiguration Configuration

@{
    var configuredPathBase = Configuration.GetValue<string>(WebConstants.WebBasePathSettingsName) ?? "/";
    var pathBase = configuredPathBase.TrimEnd('/') + "/";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <script>
            (function () {
                var baseEl = document.querySelector('base');

                // Safety check to ensure the <base> element exists
                if (baseEl) {
                    // Convert pathname to lowercase for a case-insensitive check
                    if (window.location.pathname.toLowerCase().includes('/pdfaccessibility')) {
                        baseEl.setAttribute('href', '/PDFAccessibility/');
                    } else {
                        // Default fallback for localhost
                        baseEl.setAttribute('href', '/');
                    }
                }
            })();
    </script>

    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="AccessibilityAuditorApp.styles.css" />

    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="download.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>